# Naukri Recruiter credentials
NAUKRI_USERNAME=
NAUKRI_PASSWORD=

# LiteLLM proxy (OpenAI-compatible) - Claude Haiku 4.5
LITELLM_BASE_URL=https://ai-litellm.inside10d.com/v1
LITELLM_API_KEY=
LITELLM_MODEL=claude-haiku-4-5-20251001

# Runtime paths
JD_INPUT_DIR=jd_input
GUIDELINES_DIR=screening_guidelines
RESUMES_DIR=resumes
OUTPUTS_DIR=outputs
LOGS_DIR=logs
SESSION_DIR=config/.session

# Execution
HEADLESS=true
MAX_RESUMES_PER_JD=50
DOWNLOAD_TIMEOUT_SEC=60
